  "linkChanges": [
    {
      "name": "docs/editorial/blog-custom-software-australia/03-articulo-custom-software-australia.md",
      "before": "It is also reasonable to change a process to fit a good existing product. Preserving every historical habit is not necessarily valuable. Distinguish the rule that protects an important outcome from a workaround people adopted because an old system was inconvenient.",
      "after": "It is also reasonable to change a process to fit a good existing product. Preserving every historical habit is not necessarily valuable. Distinguish the rule that protects an important outcome from a workaround people adopted because an old system was inconvenient.\n\nIf several automation projects are competing for the same budget, first compare [which business processes to automate first](https://rankingrebels.com/blog/which-business-processes-to-automate-first/).",
      "reason": "Standing user instruction to implement useful internal links in both directions at publication."
    },
    {
      "name": "docs/editorial/blog-ai-agents-workflows-australia/03-articulo-ai-agents-workflows-australia.md",
      "before": "A CRM, or customer relationship management system, is one possible destination for the work. Your inbox, calendar or document store may be others. Their availability still needs to be checked against the actual integration, subscription plan and access settings.",
      "after": "A CRM, or customer relationship management system, is one possible destination for the work. Your inbox, calendar or document store may be others. Their availability still needs to be checked against the actual integration, subscription plan and access settings.\n\nIf a required capability is missing, compare [configuring, extending or building software](https://rankingrebels.com/blog/custom-software-benefits/) before commissioning another system. A small component may fill the gap while the tools you already use keep doing their jobs.",
      "reason": "Standing user instruction to implement useful internal links in both directions at publication."
    },
    {
      "name": "docs/editorial/blog-automation-prioritisation-australia/03-articulo-automation-prioritisation-australia.md",
      "before": "Check the capabilities of systems you already use before commissioning another layer. Detailed software selection comes after you understand the job, its constraints and the value available.",
      "after": "Check the capabilities of systems you already use before commissioning another layer. Once the job and its value are clear, compare the [benefits and trade-offs of custom software](https://rankingrebels.com/blog/custom-software-benefits/) with configuring or extending existing tools.",
      "reason": "Standing user instruction to implement useful internal links in both directions at publication."
    }
