{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ranking-rebels-lead-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "LEAD_NOTICE_VERSION": "2026-09-03",
    "LEAD_ALLOWED_HOSTNAMES": "rankingrebels.com,www.rankingrebels.com",
    "LEAD_EMAIL_FROM": "leads@forms.rankingrebels.com",
    "LEAD_EMAIL_TO": "rankingrebelsmarketingagency@gmail.com",
    "LEAD_REQUEUE_AFTER_SECONDS": "86400"
  },

  // The database ID is intentionally non-deployable until provisioning.
  // Keep real resource IDs and secrets out of source control.
  // Create the D1 database with --jurisdiction eu; jurisdiction is not a
  // supported field in a d1_databases binding object.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ranking-rebels-leads",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "LEAD_EMAIL_QUEUE",
        "queue": "ranking-rebels-lead-email"
      }
    ],
    "consumers": [
      {
        "queue": "ranking-rebels-lead-email",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "ranking-rebels-lead-email-dlq"
      }
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": [
        "rankingrebelsmarketingagency@gmail.com"
      ]
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "routes": [
    {
      "pattern": "rankingrebels.com/api/leads*",
      "zone_name": "rankingrebels.com"
    },
    {
      "pattern": "www.rankingrebels.com/api/leads*",
      "zone_name": "rankingrebels.com"
    }
  ]
}
